#include <iostream>

using namespace std;

int calculateIntAverage(int a, int b, int c) 
{

    return (a + b + c) / 3;
}

double calculateDoubleAverage(int a, int b, int c) 
{

    return (a + b + c) / 3.0;
}

int main() 
{
    int a, b, c;

    cout << "Введите три оценки: ";
    cin >> a >> b >> c;

    int intAvg = calculateIntAverage(a, b, c);
    double exactAvg = calculateDoubleAverage(a, b, c);

    cout << "Средний балл (целочисленный): " << intAvg << endl;
    cout << "Средний балл (точный): " << exactAvg << endl;

    return 0;
}
