#include "iostream"
#include "vector"
#include "clocale"
#include "time.h"
using namespace std;
void PrintRanhe(int start, int end)
{
	for (int i = start; i < end; i++)
	{
		cout << i << endl;
	}
}
int main()
{
	srand(time(NULL));
	setlocale(LC_ALL, ".UTF-8");
	int start; int end;
	cin >> start >> end;
	PrintRanhe(start, end);
}
